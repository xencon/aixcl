{
  "$schema": "https://opencode.ai/config.json",
  "shell": "bash",
  "logLevel": "WARN",
  "snapshot": true,
  "share": "manual",
  "autoupdate": "notify",
  "watcher": {
    "ignore": [
      "node_modules/",
      ".git/",
      "*.log",
      "volumes/",
      "pgadmin-data/",
      "tests/*.backup",
      "*.tmp",
      "*.swp",
      "build/",
      "dist/"
    ]
  },
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/*.md",
    ".opencode/memory/MEMORY.md"
  ],
  "default_agent": "agent-context",
  "agent": {
    "safety": {
      "description": "Chat with the NVIDIA content-safety classifier (no tools sent)",
      "mode": "primary",
      "model": "nvidia/nvidia/llama-3.1-nemotron-safety-guard-8b-v3",
      "tools": {
        "*": false
      }
    }
  },
  "provider": {
    "nvidia": {
      "api_base": "https://integrate.api.nvidia.com/v1",
      "models": {
        "nvidia/llama-3.1-nemotron-safety-guard-8b-v3": {
          "name": "Nemotron Safety Guard 8B v3",
          "tool_call": false
        },
        "mistralai/mistral-nemotron": {
          "name": "Mistral Nemotron",
          "tool_call": true
        },
        "meta/llama-3.1-8b-instruct": {
          "name": "Llama 3.1 8B Instruct",
          "tool_call": true
        },
        "meta/llama-3.1-70b-instruct": {
          "name": "Llama 3.1 70B Instruct",
          "tool_call": true
        },
        "meta/llama-3.3-70b-instruct": {
          "name": "Llama 3.3 70B Instruct",
          "tool_call": true
        }
      }
    },
    "aixcl-local": {
      "api_base": "http://localhost:11434/v1",
      "models": {
        "qwen3-coder:30b-32k": {
          "name": "Qwen3 Coder 30B (32k ctx)",
          "tool_call": true
        }
      }
    },
    "opencode": {
      "api_base": "https://opencode.ai/api",
      "models": {
        "nemotron-3-ultra-free": {
          "name": "Nemotron 3 Ultra (Free)",
          "tool_call": true
        },
        "nemotron-3.5-lightning-free": {
          "name": "Nemotron 3.5 Lightning (Free)",
          "tool_call": true
        },
        "big-pickle": {
          "name": "Big Pickle",
          "tool_call": true
        },
        "hy3-free": {
          "name": "HY3 Free",
          "tool_call": true
        },
        "x-preview-f-free": {
          "name": "X Preview F Free",
          "tool_call": true
        },
        "mimo-v2.5-free": {
          "name": "MIMO v2.5 Free",
          "tool_call": true
        },
        "muse-spark-1.2-contributor-free": {
          "name": "Muse Spark 1.2 Contributor Free",
          "tool_call": true
        }
      }
    }
  },
  "model": "opencode/nemotron-3-ultra-free",
  "small_model": "opencode/nemotron-3.5-lightning-free"
}
